<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_royal_velvet">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/detailsTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_translucent"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/details_title"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailsCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_gold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/qv_accent_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            tools:text="WISDOM" />

    </LinearLayout>

    <!-- Main Full-Screen Quote Showcase -->
    <ScrollView
        android:id="@+id/detailsQuoteScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/stylePickerContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailsTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingVertical="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/quote_mark_glyph"
                android:textColor="@color/qv_accent_gold"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailsQuoteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.28"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_detail_quote"
                tools:text="Knowing yourself is the beginning of all wisdom." />

            <View
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@color/qv_accent_gold" />

            <TextView
                android:id="@+id/tvDetailsAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:textColor="@color/qv_white_translucent_80"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="— Aristotle" />

        </LinearLayout>

    </ScrollView>

    <!-- Gradient / Atmosphere Picker and Typography Controls -->
    <LinearLayout
        android:id="@+id/stylePickerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/detailsActionCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStyleSwatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            tools:listitem="@layout/item_style_swatch" />

        <!-- Font & Size Controls Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_translucent"
            android:backgroundTint="@color/qv_black_translucent_30"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/btnFontSerif"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_pill_translucent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="serif"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Serif"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFontSans"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Sans"
                android:textColor="@color/qv_white_translucent_80"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFontMono"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Mono"
                android:textColor="@color/qv_white_translucent_80"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFontCasual"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="casual"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Casual"
                android:textColor="@color/qv_white_translucent_80"
                android:textSize="12sp" />

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/qv_white_translucent_20" />

            <!-- Font Size Down -->
            <ImageButton
                android:id="@+id/btnFontSizeDown"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_decrease_font"
                android:padding="6dp"
                android:src="@drawable/ic_remove"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvFontSizeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:gravity="center"
                android:minWidth="28dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="26" />

            <!-- Font Size Up -->
            <ImageButton
                android:id="@+id/btnFontSizeUp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_increase_font"
                android:padding="6dp"
                android:src="@drawable/ic_add"
                app:tint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Action Dock -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detailsActionCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:cardBackgroundColor="@color/qv_black_translucent_30"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/qv_white_translucent_20"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <LinearLayout
                android:id="@+id/actionFavorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivDetailsFavorite"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_favorite_toggle"
                    android:src="@drawable/ic_favorite_outline"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_favorite"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_copy_quote"
                    android:src="@drawable/ic_copy"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_copy"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_share_quote"
                    android:src="@drawable/ic_share"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_share"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionSaveImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_save_image"
                    android:src="@drawable/ic_download"
                    app:tint="@color/qv_accent_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_save_image"
                    android:textColor="@color/qv_accent_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

