<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recentCardRoot"
    android:layout_width="@dimen/recent_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/card_elevation_subtle"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/recentGradientContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_obsidian_gold"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecentCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_gold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/qv_accent_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                tools:text="MOTIVATION" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnRecentFavorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_favorite_toggle"
                android:padding="6dp"
                android:src="@drawable/ic_favorite_outline"
                app:tint="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecentQuote"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="3"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            tools:text="Act as if what you do makes a difference. It does." />

        <TextView
            android:id="@+id/tvRecentAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/qv_white_translucent_80"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="— William James" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

