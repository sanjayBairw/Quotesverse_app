<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuoteVerse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/qv_primary</item>
        <item name="colorOnPrimary">@color/qv_on_primary</item>
        <item name="colorPrimaryContainer">@color/qv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/qv_on_primary_container</item>

        <item name="colorSecondary">@color/qv_secondary</item>
        <item name="colorOnSecondary">@color/qv_on_secondary</item>
        <item name="colorSecondaryContainer">@color/qv_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/qv_on_secondary_container</item>

        <item name="colorTertiary">@color/qv_accent_gold</item>
        <item name="colorOnTertiary">@color/qv_on_accent_gold</item>

        <item name="android:colorBackground">@color/qv_light_background</item>
        <item name="colorSurface">@color/qv_light_surface</item>
        <item name="colorSurfaceContainer">@color/qv_light_surface</item>
        <item name="colorSurfaceContainerLow">@color/qv_light_surface</item>
        <item name="colorSurfaceContainerHigh">@color/qv_light_surface_variant</item>
        <item name="colorSurfaceVariant">@color/qv_light_surface_variant</item>
        <item name="colorOnSurface">@color/qv_light_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/qv_light_text_secondary</item>
        <item name="colorOutlineVariant">@color/qv_light_outline</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ShapeAppearance.QuoteVerse.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.QuoteVerse.HeroCard" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/radius_hero</item>
    </style>

    <style name="TextAppearance.QuoteVerse.QuoteEditorial" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.QuoteVerse.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
</resources>

